# Select exactly one environment. Use preview until a separate test project is configured.
# preview | test | live
VITE_BIDDWORLD_MODE=preview

# Supply the URL and PUBLIC publishable/anon key for the selected Supabase project.
# TEST mode must use a separate disposable Supabase project, never BiddWorld-Production.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy alternative (only if the project still uses anon keys):
# VITE_SUPABASE_ANON_KEY=REPLACE_ME

# Never add service_role or secret keys to VITE_ variables.
